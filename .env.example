# Long random string: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Public URL of the app, used in password-reset emails.
APP_URL=http://localhost:5000

# Outgoing email for password resets. Leave MAIL_SERVER empty in development:
# the reset email (with its link) is printed to the server log instead.
# Free options: Gmail (smtp.gmail.com, port 587, an "app password"), Brevo free tier, ...
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Sent to MusicBrainz/ListenBrainz with every request (they ask for a meaningful one).
# Add a URL or contact for your deployment, e.g. "WAYL/1.0 (https://your-site.example)".
CATALOG_USER_AGENT=WAYL/1.0 (self-hosted music log)
